# Tuwunel reads the rendered file only at start, and compose recreates it only
# when the tuwunel service in docker-compose.yml changes. A change here reaches
# running stacks with a change there, or once operators restart tuwunel.
[global]

server_name = "@@SERVER_NAME@@"

database_path = "/var/lib/tuwunel"

address = ["0.0.0.0"]
port = [6167]

# Registration is ENABLED but gated by registration_token below — a random user
# cannot self-register without it. Waldur provisions users through that token
# (the m.login.registration_token flow), so this must stay true. The accounts it
# creates get no password: in password mode the bot sets a generated one through
# the admin API, which needs the bot to be a homeserver admin
# (!admin users make-user-admin).
#
# WALDUR_MATRIX_OPEN_REGISTRATION drops the token requirement entirely (the flag
# below), making the server openly abusable. Keep it false unless you mean it.
allow_registration = true
yes_i_am_very_very_sure_i_want_an_open_registration_server_prone_to_abuse = @@OPEN_REGISTRATION@@

registration_token = "@@REG_TOKEN@@"

# Synapse-compatible shared-secret register endpoint (Tuwunel 1.7.0+): POST
# /_synapse/admin/v1/register with HMAC-SHA1 of the returned nonce keyed by it.
# waldur-matrix-register creates the bootstrap admin through it, and operators
# create other admins the same way.
registration_shared_secret = "@@REG_TOKEN@@"

# Otherwise the first account on the server becomes its admin, and Waldur
# registers an account for whoever opens the chat first. The setup in the docs
# creates the admin explicitly ("admin": true).
grant_admin_to_first_user = false

max_request_size = 104857600

# Waldur's chat drawer signs in with a refresh token, so its access tokens
# expire after 5 minutes and are renewed in the background. The refresh
# lifetime is an idle timeout: each refresh moves it forward, and a page left
# silent for a day (e.g. on a suspended laptop) starts a new session through
# Waldur. Clients that sign in without a refresh token (Element with a
# password) keep non-expiring tokens.
access_token_ttl = 300
refresh_token_ttl = 86400

# Media is served from the same origin as Waldur's web UI here, and only ever
# shown through the chat clients: refuse to be framed, and allow no inline
# styles in media served as documents (e.g. SVG).
media_deny_framing = true
media_deny_inline_styles = true

# Calls do not need federation: Waldur verifies a caller's Matrix OpenID
# token at /_matrix/federation/v1/openid/userinfo on the internal
# MATRIX_HOMESERVER_URL (tuwunel.internal:6167), which Tuwunel serves with
# federation off too. Turning it off affects only federation with other
# homeservers.
allow_federation = true

# No DNS cache. The appservice URL names the mastermind API container, whose IP
# changes whenever compose recreates it (every image bump), and a cached answer
# keeps the homeserver dialling the old IP: the bot stops hearing messages for
# up to dns_min_ttl (3 h) by default, or Docker's 600 s TTL with
# dns_passthru_appservices. Docker's embedded DNS answers locally, and on a
# single host outbound federation is rare, so a lookup per request costs little.
dns_cache_entries = 0

# Password login for Matrix clients such as Element. Set
# WALDUR_MATRIX_LOGIN_WITH_PASSWORD=false with single sign-on, or when users get
# no external client at all. Waldur's chat drawer signs in through the
# appservice and is unaffected.
login_with_password = @@LOGIN_WITH_PASSWORD@@

# Single sign-on only: the bot's localpart, waldur-bootstrap (reserved for the
# bootstrap admin that automatic registration will create) and
# WALDUR_MATRIX_SSO_FORBIDDEN_USERNAMES, which no identity provider account may
# sign in to or register. Empty without single sign-on.
@@FORBIDDEN_USERNAMES@@

[global.well_known]
client = "https://@@SERVER_NAME@@"
server = "@@SERVER_NAME@@:443"

@@RTC_BLOCK@@
