[global]

server_name = "@@SERVER_NAME@@"

database_path = "/var/lib/tuwunel"

address = ["0.0.0.0"]
port = [6167]

# Registration is ENABLED but gated by registration_token below — a random user
# cannot self-register without it. Waldur provisions users through that token
# (the m.login.registration_token flow), which is also the only path that sets a
# usable password on Tuwunel, so this must stay true for password login to work.
#
# WALDUR_MATRIX_OPEN_REGISTRATION drops the token requirement entirely (the flag
# below), making the server openly abusable. Keep it false unless you mean it.
allow_registration = true
yes_i_am_very_very_sure_i_want_an_open_registration_server_prone_to_abuse = @@OPEN_REGISTRATION@@

registration_token = "@@REG_TOKEN@@"

# Synapse-compatible shared-secret register endpoint (Tuwunel 1.7.0+). Waldur
# does NOT use this (it provisions via the registration_token flow above); left
# available for operators who want to register users via POST
# /_synapse/admin/v1/register with HMAC-SHA1 of the returned nonce keyed by it.
registration_shared_secret = "@@REG_TOKEN@@"

# Otherwise the first account on the server becomes its admin, and Waldur
# registers an account for whoever opens the chat first. The setup in the docs
# creates the admin explicitly ("admin": true).
grant_admin_to_first_user = false

max_request_size = 104857600

# Waldur's chat drawer signs in with a refresh token, so its access tokens
# expire after 5 minutes and are renewed in the background. The refresh
# lifetime is an idle timeout: each refresh moves it forward, and a page left
# silent for a day (e.g. on a suspended laptop) starts a new session through
# Waldur. Clients that sign in without a refresh token (Element with a
# password) keep non-expiring tokens.
access_token_ttl = 300
refresh_token_ttl = 86400

# Media is served from the same origin as Waldur's web UI here, and only ever
# shown through the chat clients: refuse to be framed, and allow no inline
# styles in media served as documents (e.g. SVG).
media_deny_framing = true
media_deny_inline_styles = true

# Federation must be ON for lk-jwt-service to verify Matrix OpenID tokens
# via /_matrix/federation/v1/openid/userinfo (used during the call
# token exchange). Disabling federation breaks calls.
allow_federation = true

[global.well_known]
client = "https://@@SERVER_NAME@@"
server = "@@SERVER_NAME@@:443"

@@RTC_BLOCK@@
