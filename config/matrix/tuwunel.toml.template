# Tuwunel reads the rendered file only at start, and compose recreates it only
# when the tuwunel service in docker-compose.yml changes. A change here reaches
# running stacks with a change there, or once operators restart tuwunel.
[global]

server_name = "@@SERVER_NAME@@"

database_path = "/var/lib/tuwunel"

address = ["0.0.0.0"]
port = [6167]

# Registration is ENABLED but gated by registration_token below — a random user
# cannot self-register without it. Waldur provisions users through that token
# (the m.login.registration_token flow), which is also the only path that sets a
# usable password on Tuwunel, so this must stay true for password login to work.
#
# WALDUR_MATRIX_OPEN_REGISTRATION drops the token requirement entirely (the flag
# below), making the server openly abusable. Keep it false unless you mean it.
allow_registration = true
yes_i_am_very_very_sure_i_want_an_open_registration_server_prone_to_abuse = @@OPEN_REGISTRATION@@

registration_token = "@@REG_TOKEN@@"

# Synapse-compatible shared-secret register endpoint (Tuwunel 1.7.0+): POST
# /_synapse/admin/v1/register with HMAC-SHA1 of the returned nonce keyed by it.
# waldur-matrix-register creates the bootstrap admin through it, and operators
# create other admins the same way.
registration_shared_secret = "@@REG_TOKEN@@"

max_request_size = 104857600

# Federation must be ON for lk-jwt-service to verify Matrix OpenID tokens
# via /_matrix/federation/v1/openid/userinfo (used during the call
# token exchange). Disabling federation breaks calls.
allow_federation = true

# No DNS cache. The appservice URL names the mastermind API container, whose IP
# changes whenever compose recreates it (every image bump), and a cached answer
# keeps the homeserver dialling the old IP: the bot stops hearing messages for
# up to dns_min_ttl (3 h) by default, or Docker's 600 s TTL with
# dns_passthru_appservices. Docker's embedded DNS answers locally, and on a
# single host outbound federation is rare, so a lookup per request costs little.
dns_cache_entries = 0

[global.well_known]
client = "https://@@SERVER_NAME@@"
server = "@@SERVER_NAME@@:443"

@@RTC_BLOCK@@
