{
	default_sni {$VIRTUAL_HOST}
}

(cors) {
	# Waldur's call token API (/api/matrix/livekit/) is called by Matrix
	# clients on any origin, Element among them, and answers with its own
	# `Access-Control-Allow-Origin: *` and no credentials, preflights included.
	# Echoing the origin with credentials on top would send two
	# Access-Control-Allow-Origin headers, which browsers reject.
	@cors_preflight {
		method OPTIONS
		not path /api/matrix/livekit/*
	}
	@cors_credentialed not path /api/matrix/livekit/*
	header @cors_credentialed {
		Access-Control-Allow-Origin "{args.0}"
		Vary Origin
		Access-Control-Allow-Headers "*"
		Access-Control-Expose-Headers "Authorization, Link, X-Result-Count"
		Access-Control-Allow-Credentials "true"
	}
	handle @cors_preflight {
		header {
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE"
			Access-Control-Allow-Headers "*"
			Access-Control-Max-Age "3600"
		}
		respond "" 204
	}
}

{$VIRTUAL_HOST} {
	tls {$TLS}

	# Compress proxied responses at the serving layer. API JSON (e.g.
	# /api/roles/) is dominated by repeated permission-enum strings and
	# shrinks ~85% under compression; homeport static assets benefit too.
	# Caddy negotiates via Accept-Encoding and sets Vary accordingly.
	# Restrict to compressible content types so we don't waste CPU
	# re-compressing already-compressed /media/ uploads (JPEG/PNG/PDF/zip).
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/*+json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	# A response that carries no Content-Security-Policy of its own gets the
	# one mastermind sends on its API responses: Caddy's own answers, such as
	# the CORS preflight below and the `respond`s in the includes, and upstream
	# responses without one, such as the error page gunicorn writes for a
	# request it cannot parse. `?` leaves an upstream's own policy alone. The
	# portal's, mastermind's, Keycloak's and the web shell's pages send their
	# own, as do the homeserver's auth fallback pages and media; the rest of
	# what the homeserver serves here is JSON. A page served without a policy
	# would get this one and load nothing.
	header ?Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	# Error pages Caddy generates itself, such as a 502 while an upstream is
	# down. They never reach homeport or mastermind, and the header above does
	# not apply to them, so they set the same policy themselves.
	handle_errors {
		header {
			Access-Control-Allow-Origin "{header.origin}"
			Access-Control-Allow-Credentials "true"
			Vary Origin
			Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}

	import cors {header.origin}

	# The homeport image sends the portal's Content-Security-Policy, built from
	# the CSP_* variables of the waldur-homeport service.
	reverse_proxy /* http://waldur-homeport:8080 {
		header_down X-Frame-Options DENY
		header_down Strict-Transport-Security "max-age=31536000"
		header_down -Server
	}

	reverse_proxy /api/* http://waldur-mastermind-api:8080
	reverse_proxy /api-auth/* http://waldur-mastermind-api:8080
	reverse_proxy /api-auth-browsable/* http://waldur-mastermind-api:8080
	reverse_proxy /docs/* http://waldur-mastermind-api:8080
	reverse_proxy /admin/* http://waldur-mastermind-api:8080
	reverse_proxy /static/* http://waldur-mastermind-api:8080
	reverse_proxy /media/* http://waldur-mastermind-api:8080
	reverse_proxy /apidocs/* http://waldur-mastermind-api:8080
	reverse_proxy /health-check/* http://waldur-mastermind-api:8080
	reverse_proxy /scim/* http://waldur-mastermind-api:8080
	reverse_proxy /auth/* http://keycloak:8080

	route /rmqws-stomp {
		rewrite /rmqws-stomp /ws
		reverse_proxy http://waldur-queue:15674 {
			header_up Host {host}
			header_up X-Forwarded-For {remote}
			header_up X-Real-IP {remote}
		}
	}

	route /rmqws {
		rewrite /rmqws /ws
		reverse_proxy http://waldur-queue:15675 {
			header_up Host {host}
			header_up X-Forwarded-For {remote}
			header_up X-Real-IP {remote}
		}
	}

	import /etc/caddy-includes/*.conf
}

# Any other Host over HTTPS: close the connection rather than answer with
# Caddy's empty 200. A TLS server name other than the site's (or none, which
# default_sni maps to it) already fails the handshake; this catches a Host
# header that differs from the server name.
https:// {
	abort
}
